# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/lms

# JWT secret for session tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistent Cloud Storage for Production (Vercel)
# Option 1: Cloudinary (Free tier compatible)
# Set either CLOUDINARY_URL or individual credentials:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option 2: Supabase Storage (Alternative free tier option)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
